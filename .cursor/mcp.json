{
	"mcpServers": {
		"career-space": {
			"command": "node",
			"args": ["scripts/mcp_bootstrap.js"]
		},
		"design-patterns": {
			"command": "sh",
			"args": [
				"-c",
				"AGENTS_TOOLS_DIR=\"${AGENTS_TOOLS_DIR:-$HOME/.agents}\"; exec env DATABASE_PATH=\"$AGENTS_TOOLS_DIR/design_patterns_mcp/data/design-patterns.db\" node \"$AGENTS_TOOLS_DIR/design_patterns_mcp/dist/mcp-server.js\""
			]
		},
		"ts-language": {
			"command": "npx",
			"args": ["-y", "ts-language-mcp", "."]
		}
	}
}
