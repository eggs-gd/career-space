<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title }}</title>
  <style>
    :root {
      color-scheme: light;
      --accent: #1f6f8b;
      --text: #30343a;
      --dark: #20242a;
      --muted: #626a73;
      --line: #d7dde3;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
      font-size: 13px;
      line-height: 1.36;
      background: white;
    }
    main {
      max-width: 820px;
      margin: 0 auto;
      padding: 36px 36px 40px;
    }
    h1 {
      text-align: center;
      color: var(--dark);
      font-size: 28px;
      line-height: 1.2;
      margin: 0 0 3px;
      break-after: avoid-page;
    }
    h1 + p {
      text-align: center;
      color: var(--accent);
      font-size: 15px;
      margin: 0 0 3px;
    }
    h2 {
      color: var(--accent);
      font-size: 13px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      line-height: 1.2;
      margin: 14px 0 6px;
      break-after: avoid-page;
    }
    h3 {
      color: var(--dark);
      font-size: 13px;
      line-height: 1.2;
      margin: 10px 0 0;
      break-after: avoid-page;
    }
    h4 {
      color: var(--dark);
      font-size: 13px;
      font-weight: 600;
      margin: 4px 0 0;
      break-after: avoid-page;
    }
    p {
      margin: 0 0 7px;
    }
    ul, ol {
      margin: 0 0 4px 18px;
      padding: 0;
    }
    li {
      margin: 0 0 3px;
      break-inside: avoid-page;
    }
    blockquote {
      margin: 1px 0 4px;
      padding: 0;
      border: none;
      color: var(--muted);
      font-size: 12px;
      break-inside: avoid-page;
      break-after: avoid-page;
    }
    hr {
      border: 0;
      border-top: 1px solid var(--line);
      margin: 0 0 12px;
    }
    code {
      font-family: "SFMono-Regular", ui-monospace, Menlo, Consolas, monospace;
      font-size: 0.92em;
    }
    a {
      color: var(--accent);
      text-decoration: none;
    }
    @page {
      size: A4;
      margin: 14mm;
    }
  </style>
</head>
<body class="resume-compact">
  <main>{{ body_html | safe }}</main>
</body>
</html>
