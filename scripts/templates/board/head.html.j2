<!--
  This is the head for data/board.html, and only the head -- renderBoardHtml (rendering.ts)
  builds the rest of the document itself (html/body tags, every vacancy row) as a TS template
  literal. Loaded verbatim with one placeholder substitution below (plain string .replace(),
  same convention as the resume/cover-letter templates). Don't write that placeholder's own
  literal token anywhere else in this file above where it's actually used below -- .replace()
  only touches the first match, so an earlier copy of it (even inside a comment) silently steals
  the substitution meant for the real tag further down.
-->
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title }}</title>
  <style>
    :root {
      color-scheme: light;
      --text: #111827;
      --muted: #6b7280;
      --line: #e5e7eb;
      --bg: #ffffff;
      --bg-alt: #f9fafb;
      --accent: #1f2937;
      --interview: #7c3aed;
      --applied: #2563eb;
      --tracked: #b45309;
      --new: #9ca3af;
      --rejected: #dc2626;
      --offer: #059669;
      --skipped: #9ca3af;
      --local: #0e7490;
      --local-tint: #ecfeff;
      --location-exception: #b45309;
      --location-exception-tint: #fffbeb;
      --doc: #4338ca;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      color: var(--text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 14px;
      line-height: 1.5;
      background: var(--bg-alt);
    }
    main {
      max-width: 1400px;
      margin: 0 auto;
      padding: 28px 24px 60px;
    }
    h1 {
      font-size: 22px;
      margin: 0 0 4px;
      color: var(--accent);
    }
    .meta {
      color: var(--muted);
      font-size: 13px;
      margin: 0 0 20px;
    }
    /* Summary chips are progressive enhancement; every group is present without JS. */
    .summary {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 20px;
    }
    .summary .chip {
      display: flex;
      align-items: center;
      gap: 7px;
      padding: 8px 14px;
      background: var(--bg);
      border: 1px solid var(--line);
      border-radius: 8px;
      font-family: inherit;
      font-size: 13px;
      color: inherit;
      cursor: pointer;
    }
    .summary .chip:hover { border-color: var(--accent); }
    .summary .count { font-weight: 600; }
    .dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      flex: none;
      display: inline-block;
    }
    .dot.interview { background: var(--interview); }
    .dot.applied { background: var(--applied); }
    .dot.tracked { background: var(--tracked); }
    .dot.new { background: var(--new); }
    .dot.rejected { background: var(--rejected); }
    .dot.offer { background: var(--offer); }
    .dot.skipped { background: var(--skipped); }
    section {
      margin-bottom: 32px;
    }
    section h2 {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 16px;
      margin: 0 0 12px;
      padding-top: 8px;
      border-top: 1px solid var(--line);
    }
    section h2 .n {
      color: var(--muted);
      font-weight: 400;
      font-size: 13px;
    }
    .board {
      background: var(--bg);
      border: 1px solid var(--line);
      border-radius: 8px;
      overflow: hidden;
    }
    .board-head {
      display: flex;
      gap: 12px;
      padding: 7px 12px;
      background: var(--bg-alt);
      color: var(--muted);
      font-weight: 500;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      border-bottom: 1px solid var(--line);
    }
    .vrow {
      padding: 8px 12px;
      border-bottom: 1px solid var(--line);
      border-left: 3px solid transparent;
    }
    .vrow:last-child { border-bottom: none; }
    .vrow:hover { background: var(--bg-alt); }
    /* Local = matches data/sources.yaml's local_keywords. */
    .vrow.local {
      border-left-color: var(--local);
      background: var(--local-tint);
    }
    .vrow.local:hover { background: var(--local-tint); filter: brightness(0.97); }
    .vrow.location-exception {
      border-left-color: var(--location-exception);
      background: var(--location-exception-tint);
    }
    .vrow.location-exception:hover { background: var(--location-exception-tint); filter: brightness(0.97); }
    .local-badge {
      display: inline-block;
      margin-left: 6px;
      padding: 1px 6px;
      border-radius: 10px;
      font-size: 11px;
      font-weight: 500;
      color: var(--local);
      background: var(--bg);
      border: 1px solid var(--local);
      white-space: nowrap;
      vertical-align: middle;
    }
    .location-exception-badge {
      display: inline-block;
      margin-left: 6px;
      padding: 1px 6px;
      border-radius: 10px;
      font-size: 11px;
      font-weight: 500;
      color: var(--location-exception);
      background: var(--bg);
      border: 1px solid var(--location-exception);
      white-space: nowrap;
      vertical-align: middle;
    }
    /* Only ever appears on a render explicitly asked to include archived vacancies -- the
       default excludes them entirely (see vacancy_store.listVacancies's includeArchived). Muted
       on purpose: this view is the exception, not the everyday one. */
    .vrow.archived { opacity: 0.6; }
    .archived-badge {
      display: inline-block;
      margin-left: 6px;
      padding: 1px 6px;
      border-radius: 10px;
      font-size: 11px;
      font-weight: 500;
      color: var(--muted);
      background: var(--bg-alt);
      border: 1px solid var(--line);
      white-space: nowrap;
      vertical-align: middle;
    }
    .vrow-main {
      display: flex;
      gap: 12px;
      align-items: baseline;
      flex-wrap: wrap;
    }
    .col-fit { width: 24px; font-weight: 600; font-variant-numeric: tabular-nums; flex: none; }
    .board-head .col-fit { font-weight: 500; }
    .col-company { width: 150px; font-weight: 500; flex: none; }
    .board-head .col-company { font-weight: 500; }
    .col-role { flex: 1 1 220px; min-width: 160px; }
    .col-track { width: 150px; color: var(--muted); font-size: 12.5px; flex: none; }
    .col-updated { width: 46px; color: var(--muted); font-size: 12.5px; flex: none; }
    .vrow-files {
      margin-top: 6px;
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      /* Top-aligned so an expanded <details> doesn't drag the other badges to its vertical middle. */
      align-items: flex-start;
    }
    /* Native details/summary keeps file panels usable without JavaScript. */
    details.file {
      display: inline-block;
    }
    details.file > summary {
      cursor: pointer;
      list-style: none;
      padding: 2px 8px;
      border: 1px solid var(--line);
      border-radius: 5px;
      font-size: 11px;
      color: var(--accent);
      background: var(--bg);
    }
    details.file > summary::-webkit-details-marker { display: none; }
    details.file > summary:hover { border-color: var(--accent); background: var(--bg-alt); }
    details.file[open] > summary { background: var(--accent); color: var(--bg); border-color: var(--accent); }
    /* Highlight the folder badge when a CV exists for this vacancy. */
    details.file.has-cv:not([open]) > summary {
      border-color: var(--doc);
      color: var(--doc);
      font-weight: 600;
    }
    .vrow-files a.posting-link {
      padding: 2px 8px;
      border: 1px solid var(--line);
      border-radius: 5px;
      font-size: 11px;
      color: var(--accent);
      text-decoration: none;
    }
    .vrow-files a.posting-link:hover { border-color: var(--accent); background: var(--bg-alt); }
    /* Folder panel body. */
    .file-content.folder-list {
      display: flex;
      flex-direction: column;
      gap: 4px;
      font-size: 12px;
    }
    .file-content.folder-list a { color: var(--doc); text-decoration: none; }
    .file-content.folder-list a:hover { text-decoration: underline; }
    /* Copy is progressive enhancement; the row remains useful without JS. */
    .vrow-files button.copy-btn {
      padding: 2px 8px;
      border: 1px solid var(--line);
      border-radius: 5px;
      font-family: inherit;
      font-size: 11px;
      color: var(--accent);
      background: var(--bg);
      cursor: pointer;
    }
    .vrow-files button.copy-btn:hover { border-color: var(--accent); background: var(--bg-alt); }
    .file-content {
      margin-top: 8px;
      padding: 14px 18px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--bg-alt);
      font-size: 13px;
      max-width: 720px;
    }
    .file-content h1, .file-content h2, .file-content h3 { color: var(--accent); margin: 0.8em 0 0.35em; }
    .file-content h1 { font-size: 17px; }
    .file-content h2 { font-size: 15px; }
    .file-content h3 { font-size: 13.5px; }
    .file-content p, .file-content ul, .file-content ol { margin: 0.55em 0; }
    .file-content table { border-collapse: collapse; font-size: 12px; }
    .file-content td, .file-content th { border: 1px solid var(--line); padding: 4px 8px; }
    .empty {
      color: var(--muted);
      font-size: 13px;
      padding: 10px 0;
    }
  </style>
</head>
